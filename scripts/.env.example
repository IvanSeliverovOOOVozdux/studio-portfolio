# Скопируйте нужные строки в C:\Users\sasha\works\.env (локально) и в Vercel -> Settings -> Environment Variables (для сайта).
# Этот файл — только образец, настоящих значений в нём нет.

# Бот: создаётся у @BotFather командой /newbot
TG_BOT_TOKEN=
# Секрет вебхука: любая длинная случайная строка (латиница и цифры, до 256 символов)
TG_WEBHOOK_SECRET=
# ID общего чата троих (отрицательное число для группы), сюда приходят отзывы на проверку
TG_CHAT_ID=
# ID темы группы (форум), куда приходят карточки отзывов; оставьте пустым, если тем нет
TG_THREAD_ID=
# Telegram ID трёх партнёров через запятую (узнать: @userinfobot)
TG_ALLOWED_IDS=

# База: Upstash Redis -> Database -> REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Адрес опубликованного портфолио, https://... без слэша в конце
SITE_URL=
# Любая случайная строка: «соль» для хэша IP (лимит от накрутки)
IP_SALT=
# Сколько дней живёт ссылка на отзыв (по умолчанию 30)
LINK_TTL_DAYS=30
